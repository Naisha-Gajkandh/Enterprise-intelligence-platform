# Base URL of the FastAPI backend (no trailing slash).
# All routers are mounted under this base, e.g. VITE_API_BASE_URL/api/v1/auth
VITE_API_BASE_URL=http://localhost:8000

# API version prefix used by every router in app/main.py
VITE_API_PREFIX=/api/v1

# Milliseconds to wait for a backend response before an adapter falls back
# to mock data (System Health probes use this too).
VITE_API_TIMEOUT_MS=6000

# When true, the console will use mock data immediately without attempting
# a network call first. Useful for demos with no backend running.
VITE_FORCE_MOCK=false
